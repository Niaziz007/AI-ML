    "import os\n",
    "import openai\n",
    "import base64\n",
    "from io import BytesIO\n",
    "from PIL import Image\n",
    "\n",
    "# Initialize the client with your API key\n",
    "client = openai.OpenAI(api_key=os.getenv('OPENAI_API_KEY'))\n",
    "\n",
    "with open(\"converted_image.png\", \"rb\") as image_file, open(\"mask.png\", \"rb\") as mask_file:\n",
    "    response = client.images.edit(\n",
    "        image=image_file,\n",
    "        mask=mask_file,\n",
    "        prompt=\"Transform this photo into a whimsical illustration in the style of Studio Ghibli with a soft watercolor palette and magical details.\",\n",
    "        n=1,\n",
    "        size=\"1024x1024\",\n",
    "        response_format=\"b64_json\"\n",
    "    )\n",
    "\n",
    "# Get the Base64 string from the response\n",
    "img_b64 = response.data[0].b64_json\n",
    "\n",
    "# Decode the Base64 string to bytes and display the image\n",
    "img_bytes = base64.b64decode(img_b64)\n",
    "edited_img = Image.open(BytesIO(img_bytes))\n",
    "edited_img.show()\n",
    "# Optionally: edited_img.save(\"edited_output.png\")\n"
   ]
  },
