   "source": [
    "from PIL import Image\n",
    "\n",
    "# Open your converted image (which is 1024x1024)\n",
    "img = Image.open(\"converted_image.png\")\n",
    "# Create a fully transparent mask with the same dimensions\n",
    "mask = Image.new(\"RGBA\", img.size, (0, 0, 0, 0))\n",
    "mask.save(\"mask.png\")\n"
   ]
